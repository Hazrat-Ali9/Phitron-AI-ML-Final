# Copy to .env and fill in. Variables marked REQUIRED have no default:
# the API refuses to start if any of them is missing.

# development | production | test
APP_ENV=development

# REQUIRED. postgres:// and postgresql:// are rewritten to postgresql+asyncpg:// automatically.
# Use host "localhost" when running the API on your machine, "db" inside docker compose.
DATABASE_URL=postgresql+asyncpg://baribhara:baribhara@localhost:5432/baribhara

# REQUIRED, at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-me-run-openssl-rand-hex-32-and-paste-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# REQUIRED. Any OpenAI-compatible chat endpoint; the model must support tool calling.
# Default: Google Gemini (free key at https://aistudio.google.com/apikey).
# Groq instead: LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your-gemini-api-key
LLM_MODEL=gemini-2.5-flash

# REQUIRED (except the key). OpenAI-compatible /embeddings endpoint, Gemini by default.
# Leave EMBEDDING_API_KEY empty to reuse LLM_API_KEY.
# EMBEDDING_DIM must match the vector(768) column from migration 0004.
EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
EMBEDDING_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# RAG: chunks returned per question, and the cosine-similarity cut-off below which
# a chunk counts as "not relevant" (tuned with POST /api/v1/knowledge/search)
RAG_TOP_K=4
RAG_MIN_SCORE=0.65

# Optional: if set, requests to /mcp must send header X-API-Key with this value
MCP_API_KEY=
